@model ElectricityViewModel
@{ ViewData["Title"] = "Buy electricity"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h2 class="mb-0">Buy electricity</h2><a asp-action="Pay" class="btn btn-outline-primary">Pay bills</a></div>
<div class="row g-4 mb-4">
    <div class="col-lg-5">
        <div class="pay-card account-card">
            <span class="chip"></span><span class="brand gold">UFS</span>
            <div class="pan">@Model.AccountNumber</div>
            <div class="d-flex justify-content-between align-items-end">
                <div><div class="tiny">Account holder</div><div class="fw-semibold">@Model.CustomerName.ToUpper()</div><div class="small opacity-75">@Model.IdentificationNumber</div></div>
                <div class="text-end"><div class="tiny">Balance</div><div class="fs-4 gold">@Model.CurrentUnits.ToString("N2")</div><div class="tiny">units (kWh)</div></div>
            </div>
        </div>
    </div>
    <div class="col-lg-7"><div class="card dashboard-card p-3 h-100"><h6>Recent electricity activity</h6>
        @if (!Model.Recent.Any()) { <div class="text-secondary small">No activity yet.</div> }
        <table class="table table-sm small mb-0"><tbody>
        @foreach (var e in Model.Recent)
        {
            <tr><td>@e.Date.ToLocalTime().ToString("d MMM yyyy")</td><td>@(e.TransactionType)@if (!string.IsNullOrEmpty(e.MetroToken)) { <div class="text-secondary">Token @MetroToken.Format(e.MetroToken)</div> }</td>
                <td>@(e.TransactionType == "Purchase" ? "+" : "-")@e.Units.ToString("N2") units @@ &#82;@e.Rate.ToString("N2")</td><td class="text-end">&#82;@e.Amount.ToString("N2")</td></tr>
        }
        </tbody></table></div></div>
</div>
<div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
<form asp-action="Electricity" method="post" id="payForm" novalidate>
<div class="row g-4">
    <div class="col-lg-6"><div class="card dashboard-card p-3">
        <h5>How many units do you need?</h5>
        <label class="form-label fw-semibold" for="Units">Units (kWh)</label>
        <input type="number" class="form-control form-control-lg" id="Units" name="Units" min="1" max="1000" step="0.5" value="@Model.Units.ToString(System.Globalization.CultureInfo.InvariantCulture)" required />
        <div class="d-flex gap-2 my-2">@foreach (var q in new[] { 20, 50, 100, 200 }) { <button type="button" class="btn btn-sm btn-outline-secondary quick" data-u="@q">@q</button> }</div>
        <div class="alert alert-info mb-0">Current rate: <strong>&#82;@Model.Rate.ToString("N2")</strong> per unit.<br />You will pay: <strong id="costText">R0.00</strong></div>
    </div></div>
    <div class="col-lg-6"><div class="card dashboard-card p-3">
        <h5>Card details</h5>
        <div class="mb-3"><partial name="_CardPreview" /></div>
        <partial name="_CardFields" model="Model" />
        <button type="button" class="btn btn-primary w-100 mt-3" id="payBtn"><i class="fa-solid fa-bolt"></i> Buy units now</button>
    </div></div>
</div>
<partial name="_ConfirmModal" />
</form>
@section Scripts {
<script src="~/js/payment.js" asp-append-version="true"></script>
<script>
    (function () {
        var rate = @Model.Rate.ToString(System.Globalization.CultureInfo.InvariantCulture), units = document.getElementById('Units');
        function cost() { return Math.round((parseFloat(units.value) || 0) * rate * 100) / 100; }
        function refresh() { document.getElementById('costText').textContent = 'R' + cost().toFixed(2); }
        units.addEventListener('input', refresh);
        document.querySelectorAll('.quick').forEach(function (b) { b.addEventListener('click', function () { units.value = b.dataset.u; refresh(); }); });
        refresh();
        initCardForm(cost, function () { var u = parseFloat(units.value); return (u >= 1 && u <= 1000) ? '' : 'Enter between 1 and 1000 units.'; });
    })();
</script>
}

@model ErrorViewModel
@{ ViewData["Title"] = "Error"; }
<h2 class="text-danger">Something went wrong</h2>
<p>An error occurred while processing your request. Please try again or return to the <a asp-action="Index">home page</a>.</p>
@if (Model.ShowRequestId) { <p class="text-muted small">Request ID: <code>@Model.RequestId</code></p> }

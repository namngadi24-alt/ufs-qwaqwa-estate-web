@model ForgotPasswordViewModel
@{ ViewData["Title"] = "Request a password reset"; }
<div class="row justify-content-center"><div class="col-md-7 col-lg-6"><div class="card dashboard-card p-4">
    <h2>Financial officer password reset</h2>
    <p class="text-secondary">Enter your details so we can verify your identity. The administrator reviews every request - there is no automatic reset.</p>
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    <form asp-action="ForgotPassword" method="post" novalidate>
        <div class="mb-3"><label asp-for="Email" class="form-label fw-semibold"></label><input asp-for="Email" class="form-control" type="email" required /></div>
        <div class="mb-3"><label asp-for="IdentificationNumber" class="form-label fw-semibold"></label><input asp-for="IdentificationNumber" class="form-control" inputmode="numeric" required /></div>
        <div class="mb-3"><label asp-for="PhoneNumber" class="form-label fw-semibold"></label><input asp-for="PhoneNumber" class="form-control" type="tel" required /></div>
        <div class="mb-3"><label asp-for="Reason" class="form-label fw-semibold"></label><textarea asp-for="Reason" class="form-control" rows="3" maxlength="500" required></textarea></div>
        <button class="btn btn-primary" type="submit">Send request to administrator</button>
        <a asp-action="Login" class="btn btn-link">Back</a>
    </form></div></div></div>

@model List<Accommodation>
@{
    ViewData["Title"] = "Browse accommodation";
    var rooms = (List<RoomInfo>)ViewBag.Rooms;
    string? selType = ViewBag.Type as string;
    string? selRoom = ViewBag.RoomType as string;
    bool availOnly = ViewBag.AvailableOnly is bool b && b;
}
<div class="page-header mb-3"><h2>Browse accommodation</h2><p class="text-secondary mb-0">No account needed - register only when you want to apply.</p></div>
<form method="get" class="row g-2 mb-4 align-items-end">
    <div class="col-md-3"><label class="form-label small fw-semibold">Type</label>
        <select name="type" class="form-select"><option value="">All</option>
        @foreach (var t in AccommodationTypes.All) { <option value="@t" selected="@(selType == t)">@t</option> }</select></div>
    <div class="col-md-4"><label class="form-label small fw-semibold">Room type</label>
        <select name="roomType" class="form-select"><option value="">All</option>
        @foreach (var t in RoomTypes.All) { <option value="@t" selected="@(selRoom == t)">@t</option> }</select></div>
    <div class="col-md-3"><div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="availableOnly" value="true" id="av" checked="@availOnly" /><label class="form-check-label" for="av">Available only</label></div></div>
    <div class="col-md-2"><button class="btn btn-primary w-100"><i class="fa-solid fa-filter"></i> Filter</button></div>
</form>
@if (Model.Count == 0) { <div class="empty-state p-5 text-center">No accommodation matches your filters.</div> }
<div class="row g-4">
@foreach (var a in Model)
{
    var mine = rooms.Where(r => r.Room.AccommodationId == a.AccommodationId).ToList();
    var prices = mine.Where(r => r.Rent != null).Select(r => r.Rent!.Value).ToList();
    <div class="col-md-6 col-xl-4">
        <div class="card accom-card shadow-sm h-100">
            <img src="@(a.Photos.FirstOrDefault()?.Path ?? "/images/imgufsqq.jpg")" alt="@a.AccommodationName" />
            <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between"><span class="badge badge-soft-secondary">@a.AccommodationType</span>
                    <span class="badge @(mine.Any(r => r.IsAvailable) ? "badge-soft-success" : "badge-soft-danger")">@mine.Count(r => r.IsAvailable) of @mine.Count available</span></div>
                <h5 class="mt-2">@a.AccommodationName</h5>
                <div class="small text-secondary mb-2"><i class="fa-solid fa-location-dot me-1"></i>@a.AccommodationLocation</div>
                <p class="small flex-grow-1">@a.Description</p>
                @if (prices.Count > 0) { <div class="fw-semibold mb-2">From &#82;@(prices.Min().ToString("N2")) per month</div> }
                <a asp-action="Details" asp-route-id="@a.AccommodationId" class="btn btn-primary"><i class="fa-solid fa-door-open"></i> View rooms, photos &amp; rules</a>
            </div>
        </div>
    </div>
}
</div>

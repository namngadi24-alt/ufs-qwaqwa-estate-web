@model List<Notification>
@{ ViewData["Title"] = "Notifications"; var unread = (HashSet<int>)ViewBag.UnreadIds; }
<h2 class="mb-3">Notification centre</h2>
@if (Model.Count == 0) { <div class="empty-state p-5 text-center">No notifications yet. They appear here when something happens on your account.</div> }
<div class="list-group shadow-sm">
@foreach (var n in Model)
{
    <div class="list-group-item d-flex gap-3 @(unread.Contains(n.notificationID) ? "bg-light fw-semibold" : "")">
        <div class="flex-grow-1">@n.Message<div class="small text-secondary fw-normal">@n.DateSent.ToLocalTime().ToString("d MMM yyyy HH:mm")</div></div>
        @if (unread.Contains(n.notificationID)) { <span class="badge text-bg-danger align-self-start">new</span> }
    </div>
}
</div>

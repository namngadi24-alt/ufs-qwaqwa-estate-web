@model ResetPasswordViewModel
@{ ViewData["Title"] = "Reset customer password"; }
<div class="row justify-content-center"><div class="col-lg-6"><div class="card dashboard-card p-4"><h2>Reset password</h2><p class="text-secondary">@Model.DisplayName</p>
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    <form asp-action="ResetPassword" method="post" novalidate><input type="hidden" asp-for="UserId" /><input type="hidden" asp-for="DisplayName" />
        <div class="mb-3"><label asp-for="NewPassword" class="form-label fw-semibold"></label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" required /><partial name="_PasswordRules" model="@("NewPassword")" /></div>
        <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label fw-semibold"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" required /></div>
        <button class="btn btn-warning" type="submit">Reset password</button><a asp-action="Index" class="btn btn-link">Cancel</a></form></div></div></div>

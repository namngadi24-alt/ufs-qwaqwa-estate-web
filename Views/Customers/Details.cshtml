@model CustomerDetailsViewModel
@{ ViewData["Title"] = Model.Customer.FullName; var u = Model.Customer; }
<nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Customers</a></li><li class="breadcrumb-item active">@u.FullName</li></ol></nav>
<div class="row g-3 mb-3">
    <div class="col-lg-5"><div class="card dashboard-card p-3 h-100"><h5>@u.FullName</h5>
        <div class="small">@u.PersonType @u.IdentificationNumber<br />@u.UserEmail<br />@u.PhoneNumber<br />Vehicles: @u.NumberOfVehicles<br />Account @Model.Account.AccountNumber - <strong>@Model.Account.AccountStatus</strong></div></div></div>
    <div class="col-lg-3"><div class="card stat-tile shadow-sm p-3 h-100"><div class="lbl">Outstanding</div><div class="num">&#82;@Model.Outstanding.ToString("N2")</div></div></div>
    <div class="col-lg-4"><div class="card stat-tile shadow-sm p-3 h-100"><div class="lbl">Electricity units</div><div class="num">@Model.Account.ElectricityUnits.ToString("N2")</div></div></div>
</div>
<div class="row g-3">
    <div class="col-lg-6"><div class="card dashboard-card p-3"><h6>Rooms</h6>
        @if (!Model.Allocations.Any()) { <div class="small text-secondary">None.</div> }
        @foreach (var a in Model.Allocations) { <div class="small border-bottom py-1">@a.Room.Accommodation.AccommodationName - Room @a.Room.RoomNumber (@a.Room.RoomType) from @a.MoveInDate.ToString("d MMM yyyy") <span class="badge @(a.IsActive ? "badge-soft-success" : "badge-soft-secondary")">@(a.IsActive ? "active" : "ended")</span></div> }
        <h6 class="mt-3">Applications</h6>
        @foreach (var a in Model.Applications) { <div class="small border-bottom py-1">@a.Reference - @string.Join(", ", a.Rooms.Select(r => r.Room.RoomNumber)) - @a.Status</div> }</div></div>
    <div class="col-lg-6"><div class="card dashboard-card p-3"><h6>Charges</h6>
        <table class="table table-sm small mb-0"><tbody>@foreach (var c in Model.Charges) { <tr><td>@c.Description</td><td class="text-end">&#82;@c.Amount.ToString("N2")</td><td><span class="badge @(c.IsPaid ? "badge-soft-success" : "badge-soft-warning")">@(c.IsPaid ? "Paid" : "R" + c.Balance.ToString("N2") + " due")</span></td></tr> }</tbody></table></div></div>
    <div class="col-lg-6"><div class="card dashboard-card p-3"><h6>Payments</h6>
        <table class="table table-sm small mb-0"><tbody>@foreach (var p in Model.Payments) { <tr><td><a asp-controller="Payment" asp-action="Receipt" asp-route-id="@p.PaymentId">@p.DateOfPay.ToLocalTime().ToString("d MMM yyyy")</a></td><td>@p.PaymentPurpose</td><td>&#82;@p.Amount.ToString("N2")</td><td>@p.PaymentStatus</td></tr> }</tbody></table></div></div>
    <div class="col-lg-6"><div class="card dashboard-card p-3"><h6>Electricity</h6>
        <table class="table table-sm small mb-0"><tbody>@foreach (var e in Model.Electricity) { <tr><td>@e.Date.ToLocalTime().ToString("d MMM yyyy")</td><td>@(e.TransactionType)@if (!string.IsNullOrEmpty(e.MetroToken)) { <div class="text-secondary">@MetroToken.Format(e.MetroToken)</div> }</td><td>@e.Units.ToString("N2") units</td><td>&#82;@e.Amount.ToString("N2")</td></tr> }</tbody></table></div></div>
</div>

@model EditUserViewModel
@{ ViewData["Title"] = "Edit customer"; }
<div class="row justify-content-center"><div class="col-lg-6"><div class="card dashboard-card p-4"><h2>Edit customer</h2>
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    <form asp-action="Edit" method="post" novalidate><input type="hidden" asp-for="UserId" />
        <div class="mb-3"><label asp-for="UserName" class="form-label fw-semibold"></label><input asp-for="UserName" class="form-control" required /></div>
        <div class="mb-3"><label asp-for="UserSurname" class="form-label fw-semibold"></label><input asp-for="UserSurname" class="form-control" required /></div>
        <div class="mb-3"><label asp-for="IdentificationNumber" class="form-label fw-semibold"></label><input asp-for="IdentificationNumber" class="form-control" readonly /></div>
        <div class="mb-3"><label asp-for="UserEmail" class="form-label fw-semibold"></label><input asp-for="UserEmail" class="form-control" readonly /></div>
        <div class="mb-3"><label asp-for="PhoneNumber" class="form-label fw-semibold"></label><input asp-for="PhoneNumber" class="form-control" type="tel" pattern="(\+27|0)[0-9]{9}" required /></div>
        <button class="btn btn-primary" type="submit">Save</button><a asp-action="Index" class="btn btn-link">Cancel</a></form></div></div></div>

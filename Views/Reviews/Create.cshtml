@model Review
@{
    ViewData["Title"] = "Leave a Review";
}
<h2 class="mb-4">Leave a Review</h2>

<div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
<form asp-action="Create" method="post" class="col-md-6">
    <input asp-for="ReviewId" type="hidden" />
    <div class="mb-3">
        <label asp-for="RatingScore" class="form-label">Rating (1-5)</label>
        <input asp-for="RatingScore" type="number" class="form-control" min="1" max="5" step="1" required>
    </div>
    <div class="mb-3">
        <label asp-for="ReviewDescription" class="form-label">Your Feedback</label>
        <textarea asp-for="ReviewDescription" class="form-control" rows="4"></textarea>
    </div>
    <button type="submit" class="btn btn-danger">Submit Review</button>
</form>


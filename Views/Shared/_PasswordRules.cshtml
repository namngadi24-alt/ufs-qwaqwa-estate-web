@model string
@{ var id = Model; }
<div class="small mt-2" id="rules-@id">Strength: <span class="strength-word" data-level="Weak" id="word-@id">Weak</span></div>
<script>
    (function () {
        var input = document.getElementById('@id');
        var word = document.getElementById('word-@id');
        if (!input || !word) return;
        function level(v) {
            var score = 0;
            if (v.length >= 8) score++;
            if (/[A-Z]/.test(v) && /[a-z]/.test(v)) score++;
            if (/[0-9]/.test(v)) score++;
            if (/[^A-Za-z0-9]/.test(v)) score++;
            if (v.length < 8) return 'Weak';
            return score >= 4 ? 'Strong' : score === 3 ? 'Medium' : 'Weak';
        }
        function check() { var l = level(input.value); word.textContent = l; word.setAttribute('data-level', l); }
        input.addEventListener('input', check);
        check();
    })();
</script>

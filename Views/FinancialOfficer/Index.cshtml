@{ ViewData["Title"] = "Financial dashboard"; var stats = (DashboardStats)ViewBag.Stats;
   var pending = (List<AccommodationApplication>)ViewBag.Pending; var recent = (List<Payment>)ViewBag.RecentPayments; }
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3"><h2 class="mb-0">@(User.IsInRole("Admin") ? "Financial overview" : "Financial Officer dashboard")</h2>
    <div class="d-flex gap-2 flex-wrap"><a asp-action="Applications" class="btn btn-primary">Review applications <span class="badge text-bg-light">@stats.ApplicationsPending</span></a>
    <a asp-controller="Payment" asp-action="History" asp-route-status="Pending" class="btn btn-outline-primary">Pending payments <span class="badge text-bg-warning">@stats.PaymentsPending</span></a><a asp-action="Tariffs" class="btn btn-outline-primary">Tariffs</a><a asp-action="Utilities" class="btn btn-outline-primary">Water &amp; electricity</a><a asp-action="Compliance" class="btn btn-outline-primary">Compliance</a></div></div>
<partial name="_Stats" model="stats" />
<div class="row g-4">
    <div class="col-lg-6"><div class="card dashboard-card p-3 h-100"><h5>Applications waiting for review</h5>
        @if (!pending.Any()) { <div class="text-secondary small">Nothing waiting.</div> }
        @foreach (var a in pending) { <div class="d-flex justify-content-between border-bottom py-1 small"><span>@a.Reference - @a.user.FullName (@string.Join(", ", a.Rooms.Select(r => r.Room.RoomNumber)))</span><a asp-action="Applications">Review</a></div> }</div></div>
    <div class="col-lg-6"><div class="card dashboard-card p-3 h-100"><h5>Latest payments</h5>
        @foreach (var p in recent) { <div class="d-flex justify-content-between border-bottom py-1 small"><span>@p.account.user.FullName - @p.PaymentPurpose</span><span>&#82;@p.Amount.ToString("N2") <span class="badge @(p.PaymentStatus == "Successful" ? "badge-soft-success" : p.PaymentStatus == "Pending" ? "badge-soft-warning" : "badge-soft-danger")">@p.PaymentStatus</span></span></div> }
        <a asp-controller="Payment" asp-action="History" class="small mt-2">All transactions</a></div></div>
</div>

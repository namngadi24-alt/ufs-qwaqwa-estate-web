@model List<MaintenanceRequest>
@{ ViewData["Title"] = "Maintenance"; bool hasRoom = ViewBag.HasRoom; }
<div class="d-flex justify-content-between align-items-center mb-3"><h2 class="mb-0">Maintenance requests</h2>
    @if (hasRoom) { <a asp-action="Create" class="btn btn-warning"><i class="fa-solid fa-plus me-1"></i>Report a problem</a> }</div>
@if (!hasRoom) { <div class="alert alert-info">You can report maintenance issues once your accommodation application is approved and a room is allocated.</div> }
@if (hasRoom && Model.Count == 0) { <div class="empty-state p-5 text-center">No maintenance requests yet.</div> }
@foreach (var m in Model)
{
    var cls = m.Status switch { "Resolved" => "badge-soft-success", "Closed" => "badge-soft-secondary", "In progress" => "badge-soft-warning", _ => "badge-soft-danger" };
    <div class="card dashboard-card p-3 mb-3"><div class="d-flex justify-content-between flex-wrap">
        <div><strong>@m.Category</strong> <span class="text-secondary small">- @m.Room.Accommodation.AccommodationName, Room @m.Room.RoomNumber</span></div>
        <span class="badge @cls">@m.Status</span></div>
        <p class="mb-1 mt-2">@m.Description</p>
        @if (!string.IsNullOrEmpty(m.PhotoPath)) { <a href="@m.PhotoPath" target="_blank"><img src="@m.PhotoPath" alt="Photo of the problem" style="max-height:120px" class="rounded mb-2" /></a> }
        <div class="small text-secondary">Submitted @m.DateSubmitted.ToLocalTime().ToString("d MMM yyyy") &middot; last update @m.DateUpdated.ToLocalTime().ToString("d MMM yyyy")</div>
        @if (!string.IsNullOrEmpty(m.StaffNote)) { <div class="small mt-1"><strong>Staff note:</strong> @m.StaffNote</div> }
    </div>
}

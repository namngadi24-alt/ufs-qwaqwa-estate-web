@model List<MaintenanceRequest>
@{ ViewData["Title"] = "Maintenance requests"; string current = ViewBag.Status; }
<h2 class="mb-3">Maintenance requests</h2>
<div class="btn-group mb-3" role="group">
    @foreach (var s in new[] { "All" }.Concat(MaintenanceStatuses.All))
    {
        <a asp-action="Manage" asp-route-status="@s" class="btn btn-sm @(current == s ? "btn-primary" : "btn-outline-primary")">@s</a>
    }
</div>
@if (Model.Count == 0) { <div class="empty-state p-5 text-center">No requests in this view.</div> }
@foreach (var m in Model)
{
    <div class="card dashboard-card p-3 mb-3">
        <div class="d-flex justify-content-between flex-wrap">
            <div><strong>@m.Category</strong> - @m.Room.Accommodation.AccommodationName, Room @m.Room.RoomNumber
                <div class="small text-secondary">@m.user.FullName (@m.user.IdentificationNumber, @m.user.PhoneNumber) &middot; @m.DateSubmitted.ToLocalTime().ToString("d MMM yyyy")</div></div>
            <span class="badge badge-soft-secondary align-self-start">@m.Status</span></div>
        <p class="my-2">@m.Description</p>
        @if (!string.IsNullOrEmpty(m.PhotoPath)) { <a href="@m.PhotoPath" target="_blank"><img src="@m.PhotoPath" alt="Photo" style="max-height:110px" class="rounded mb-2" /></a> }
        <form asp-action="Update" asp-route-id="@m.MaintenanceRequestId" method="post" class="row g-2 align-items-end">
            <div class="col-md-3"><label class="form-label small">Status</label><select name="status" class="form-select form-select-sm">
                @foreach (var s in MaintenanceStatuses.All) { <option value="@s" selected="@(m.Status == s)">@s</option> }</select></div>
            <div class="col-md-7"><label class="form-label small">Note to the customer</label><input name="staffNote" class="form-control form-control-sm" maxlength="500" value="@m.StaffNote" /></div>
            <div class="col-md-2"><button class="btn btn-sm btn-primary w-100"><i class="fa-solid fa-floppy-disk"></i> Save update</button></div>
        </form>
    </div>
}

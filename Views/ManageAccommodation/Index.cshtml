@model List<Accommodation>
@{ ViewData["Title"] = "Manage accommodation"; var rooms = (List<RoomInfo>)ViewBag.Rooms; }
<div class="d-flex justify-content-between align-items-center mb-3"><h2 class="mb-0">Manage accommodation</h2><a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Add accommodation</a></div>
<div class="row g-3">
@foreach (var a in Model)
{
    var mine = rooms.Where(r => r.Room.AccommodationId == a.AccommodationId).ToList();
    <div class="col-md-6 col-xl-4"><div class="card accom-card shadow-sm h-100">
        <img src="@(a.Photos.FirstOrDefault()?.Path ?? "/images/imgufsqq.jpg")" alt="@a.AccommodationName" />
        <div class="card-body"><h5>@a.AccommodationName @if (!a.IsPublished) { <span class="badge badge-soft-secondary">hidden</span> }</h5>
            <div class="small text-secondary">@a.AccommodationType &middot; @mine.Count rooms &middot; @mine.Count(r => r.IsAvailable) available</div>
            <div class="mt-3 d-flex gap-2"><a asp-action="Rooms" asp-route-id="@a.AccommodationId" class="btn btn-sm btn-primary"><i class="fa-solid fa-images"></i> Rooms &amp; photos</a><a asp-action="Edit" asp-route-id="@a.AccommodationId" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-pen"></i> Edit</a>
                <form asp-action="Delete" asp-route-id="@a.AccommodationId" method="post" onsubmit="return confirm('Delete this accommodation?');"><button class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i> Delete</button></form></div></div></div></div>
}
</div>
